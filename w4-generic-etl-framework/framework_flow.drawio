<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17" type="device">
  <diagram id="etl-framework-flow" name="Framework flow and checks">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="3793" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Generic ETL framework — high level flow and checks" style="text;html=1;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#1F3864;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="36" as="geometry"/></mxCell><mxCell id="sub" value="One batch, start to finish. CENTRE is the flow. LEFT is the configuration each step reads. RIGHT is the state it writes, or where it exits on failure.&#10;Orange diamonds are the checks. Read top to bottom: the batch level runs once, and at B7 it runs the table level once per member table." style="text;html=1;fontFamily=Arial;fontSize=11;fontColor=#404040;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="980" height="44" as="geometry"/></mxCell><mxCell id="acc" value="NO BLOCK ON THIS DIAGRAM BRANCHES ON LOAD TYPE.&#10;Load type, table type and write strategy are CONFIGURATION that parameterises B4, T4, T5 and T7 — never a fork in the path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFF00;strokeColor=#BF8F00;fontFamily=Arial;fontSize=11;fontStyle=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="128" width="980" height="56" as="geometry"/></mxCell><mxCell id="ban1" value="LEVEL 1  ·  BATCH   —   runs once per batch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontFamily=Arial;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="980" height="30" as="geometry"/></mxCell><mxCell id="B1" value="B1  ·  TRIGGER&#10;Stonebranch starts the batch" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#92D050;strokeColor=#548235;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="264" width="340" height="64" as="geometry"/></mxCell><mxCell id="B1_c" value="PASSED IN&#10;batch id&#10;business date&#10;run parameters (explicit range for a&#10;history, catchup or replay run)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="254" width="250" height="85" as="geometry"/></mxCell><mxCell id="eB1c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="B1_c" target="B1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B2" value="B2  ·  BATCH PREREQUISITE CHECK&#10;Is this batch allowed to start?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFC000;strokeColor=#BF8F00;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="383" width="300" height="92" as="geometry"/></mxCell><mxCell id="B2_c" value="READS&#10;calendar&#10;prior run of this batch — still in flight?&#10;upstream batch status" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="393" width="250" height="72" as="geometry"/></mxCell><mxCell id="eB2c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="B2_c" target="B2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B2_f" value="ABORT&#10;No run state is created at all.&#10;Notify. The cheapest possible failure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#C00000;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="399" width="260" height="59" as="geometry"/></mxCell><mxCell id="eB2f" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=10;fontColor=#C00000;" edge="1" parent="1" source="B2" target="B2_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B3" value="B3  ·  REGISTER THE BATCH RUN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F1;strokeColor=#1F3864;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="535" width="340" height="64" as="geometry"/></mxCell><mxCell id="B3_s" value="WRITES&#10;batch run record&#10;run identifier — NEW on a rerun,&#10;REUSED on a restart" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="531" width="260" height="72" as="geometry"/></mxCell><mxCell id="eB3s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="B3" target="B3_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B4" value="B4  ·  LOAD BATCH CONFIGURATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F1;strokeColor=#1F3864;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="716" width="340" height="64" as="geometry"/></mxCell><mxCell id="B4_c" value="READS — the whole scenario set&#10;member tables  ·  parallel groups&#10;prerequisite edges (declared)&#10;&#10;PER TABLE:&#10;load type:  HISTORY · CATCHUP ·&#10;INCREMENTAL · REPLAY ·&#10;FULL_REFRESH · SNAPSHOT_APPEND&#10;table type:  SCD1 · SCD2 ·&#10;APPEND_ONLY · SNAPSHOT&#10;write strategy:  SCD2_REBUILD_TIMELINE ·&#10;MERGE_SCD1 · TRUNCATE_INSERT ·&#10;INSERT_APPEND · SNAPSHOT_INSERT&#10;keys  ·  the parameterised team SQL" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="647" width="250" height="202" as="geometry"/></mxCell><mxCell id="eB4c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="B4_c" target="B4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B4_f" value="BATCH FAILED&#10;Notify. No data has been read." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#C00000;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="720" width="260" height="56" as="geometry"/></mxCell><mxCell id="eB4f" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=10;fontColor=#C00000;" edge="1" parent="1" source="B4" target="B4_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B5" value="B5  ·  MIRROR CONTROL TABLES TO SNOWFLAKE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F1;strokeColor=#1F3864;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="903" width="340" height="64" as="geometry"/></mxCell><mxCell id="B5_c" value="READS&#10;which control tables the&#10;pushed-down SQL must join" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="903" width="250" height="64" as="geometry"/></mxCell><mxCell id="eB5c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="B5_c" target="B5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B5_s" value="WRITES&#10;Snowflake working copies&#10;&#10;Needed because pushed-down SQL can&#10;only join what is IN Snowflake" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="893" width="260" height="85" as="geometry"/></mxCell><mxCell id="eB5s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="B5" target="B5_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B6" value="B6  ·  BUILD THE EXECUTION PLAN&#10;prerequisites + groups → an ATTEMPT ORDER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F1;strokeColor=#1F3864;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="1093" width="340" height="64" as="geometry"/></mxCell><mxCell id="B6_c" value="READS&#10;prerequisite edges&#10;parallel groups" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1093" width="250" height="64" as="geometry"/></mxCell><mxCell id="eB6c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="B6_c" target="B6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B6_s" value="WRITES&#10;the attempt order for this run&#10;&#10;Ordering ONLY. It guarantees every&#10;prerequisite has already been attempted&#10;by the time a table is reached — which&#10;is what lets T2 be a check, not a scheduler" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="1022" width="260" height="111" as="geometry"/></mxCell><mxCell id="eB6s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="B6" target="B6_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B6_f" value="BATCH FAILED&#10;A declared prerequisite that is not a&#10;member of this batch cannot be placed,&#10;so the plan is unbuildable. This is what&#10;defends assumption A-01." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#C00000;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="1143" width="260" height="85" as="geometry"/></mxCell><mxCell id="eB6f" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=10;fontColor=#C00000;" edge="1" parent="1" source="B6" target="B6_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B7" value="B7  ·  RUN EACH WAVE IN ORDER&#10;within a wave, tables run in parallel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F1;strokeColor=#1F3864;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="1276" width="340" height="64" as="geometry"/></mxCell><mxCell id="B7_c" value="READS&#10;the attempt order" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1276" width="250" height="64" as="geometry"/></mxCell><mxCell id="eB7c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="B7_c" target="B7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B7_s" value="A member failure does NOT stop the batch&#10;— it continues to the next table (the ABC&#10;rule). A table whose prerequisite failed&#10;becomes SKIPPED, not Failed." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="1272" width="260" height="72" as="geometry"/></mxCell><mxCell id="eB7s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="B7" target="B7_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B8" value="B8  ·  PUSH STATE BACK TO AURORA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F1;strokeColor=#1F3864;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="1398" width="340" height="64" as="geometry"/></mxCell><mxCell id="B8_s" value="WRITES&#10;Aurora — the system of record&#10;&#10;Failure here leaves Aurora and Snowflake&#10;out of step. Must be alertable, not silent." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="1388" width="260" height="85" as="geometry"/></mxCell><mxCell id="eB8s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="B8" target="B8_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B9" value="B9  ·  DETERMINE THE BATCH OUTCOME&#10;Zero member failures?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFC000;strokeColor=#BF8F00;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="1517" width="300" height="92" as="geometry"/></mxCell><mxCell id="B9_c" value="READS&#10;each member outcome:&#10;Completed · Failed · Skipped" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1531" width="250" height="64" as="geometry"/></mxCell><mxCell id="eB9c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="B9_c" target="B9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B9_f" value="BATCH = FAILED&#10;Any member failure. (Whether a batch&#10;should instead report PARTIAL is HQ-02.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#C00000;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="1533" width="260" height="59" as="geometry"/></mxCell><mxCell id="eB9f" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=10;fontColor=#C00000;" edge="1" parent="1" source="B9" target="B9_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="B10" value="B10  ·  NOTIFY AND CLOSE" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#92D050;strokeColor=#548235;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="1665" width="340" height="64" as="geometry"/></mxCell><mxCell id="B10_s" value="WRITES&#10;success or failure notification&#10;batch run closed" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="1665" width="260" height="64" as="geometry"/></mxCell><mxCell id="eB10s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="B10" target="B10_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ban2" value="LEVEL 2  ·  TABLE   —   runs once per member table, invoked at B7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontFamily=Arial;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1793" width="980" height="30" as="geometry"/></mxCell><mxCell id="T1" value="T1  ·  REGISTER THE JOB RUN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1DD;strokeColor=#375623;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="1847" width="340" height="64" as="geometry"/></mxCell><mxCell id="T1_s" value="WRITES&#10;job run record, inheriting the BATCH&#10;run identifier — so every table in a&#10;batch threads to one run" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="1843" width="260" height="72" as="geometry"/></mxCell><mxCell id="eT1s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T1" target="T1_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T2" value="T2  ·  PREREQUISITES SATISFIED?&#10;Have this table’s prerequisites completed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFC000;strokeColor=#BF8F00;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="1959" width="300" height="92" as="geometry"/></mxCell><mxCell id="T2_c" value="READS&#10;this table’s prerequisite edges&#10;their load status FOR THIS RUN" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1973" width="250" height="64" as="geometry"/></mxCell><mxCell id="eT2c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T2_c" target="T2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T2_f" value="JOB = SKIPPED&#10;No data touched. DISTINCT from Failed,&#10;because nothing went wrong with THIS&#10;table. Applies whether the prerequisite&#10;Failed or was itself Skipped." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#C00000;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="1962" width="260" height="85" as="geometry"/></mxCell><mxCell id="eT2f" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=10;fontColor=#C00000;" edge="1" parent="1" source="T2" target="T2_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T3" value="T3  ·  IS THE UPSTREAM DATA READY?&#10;Has the source landed and been declared complete?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFC000;strokeColor=#BF8F00;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="2110" width="300" height="92" as="geometry"/></mxCell><mxCell id="T3_c" value="READS&#10;the readiness rule&#10;the declared source tables&#10;(a READINESS list — the tables whose&#10;completion gates this load. NOT the set&#10;of tables the team SQL joins.)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2107" width="250" height="98" as="geometry"/></mxCell><mxCell id="eT3c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T3_c" target="T3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T3_f" value="JOB FAILED&#10;Return to B7. The batch continues." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#C00000;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="2128" width="260" height="56" as="geometry"/></mxCell><mxCell id="eT3f" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=10;fontColor=#C00000;" edge="1" parent="1" source="T3" target="T3_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T4" value="T4  ·  DETERMINE WHAT THIS RUN PROCESSES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1DD;strokeColor=#375623;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="2278" width="340" height="64" as="geometry"/></mxCell><mxCell id="T4_c" value="READS&#10;load type → window strategy:&#10;  DERIVED_WATERMARK  ·  EXPLICIT_RANGE&#10;  ·  ALL_ROWS&#10;the watermark column&#10;the explicit range, where one was supplied" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2261" width="250" height="98" as="geometry"/></mxCell><mxCell id="eT4c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T4_c" target="T4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T4_s" value="WRITES&#10;the scope of this run&#10;&#10;MECHANICS ARE LOW LEVEL DESIGN&#10;and deliberately not on this diagram" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="2267" width="260" height="85" as="geometry"/></mxCell><mxCell id="eT4s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T4" target="T4_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T5" value="T5  ·  PLAN THE PASSES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1DD;strokeColor=#375623;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="2407" width="340" height="64" as="geometry"/></mxCell><mxCell id="T5_c" value="READS&#10;pass mode: SINGLE or CHUNKED&#10;chunk unit and size" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2407" width="250" height="64" as="geometry"/></mxCell><mxCell id="eT5c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T5_c" target="T5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T5_s" value="WRITES&#10;the pass plan — fixed BEFORE anything&#10;is written, so a restart resumes&#10;rather than repeats" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="2403" width="260" height="72" as="geometry"/></mxCell><mxCell id="eT5s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T5" target="T5_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T6" value="T6  ·  REGISTER THE CHECKS FOR THIS RUN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1DD;strokeColor=#375623;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="2529" width="340" height="64" as="geometry"/></mxCell><mxCell id="T6_c" value="READS&#10;the rule catalogue&#10;this table’s rule assignments&#10;each rule’s severity: CRITICAL or&#10;INFORMATIONAL" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2519" width="250" height="85" as="geometry"/></mxCell><mxCell id="eT6c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T6_c" target="T6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T6_s" value="WRITES&#10;one open record per rule" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="2529" width="260" height="64" as="geometry"/></mxCell><mxCell id="eT6s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T6" target="T6_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T7" value="T7  ·  EXECUTE THE LOAD&#10;per pass  ·  pushed down to Snowflake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1DD;strokeColor=#375623;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="2691" width="340" height="64" as="geometry"/></mxCell><mxCell id="T7_c" value="READS&#10;the parameterised TEAM SQL — joins,&#10;lookups, aggregation, dedup, derivation&#10;the WRITE STRATEGY named in config&#10;the keys&#10;&#10;Team SQL produces a prepared row set&#10;shaped like the target. Framework SQL&#10;applies it. The team owns WHAT the rows&#10;are; the framework owns HOW they land." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2648" width="250" height="150" as="geometry"/></mxCell><mxCell id="eT7c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T7_c" target="T7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T7_s" value="WRITES&#10;target rows&#10;&#10;Rows failing a rule are split out HERE:&#10;CRITICAL  → quarantined, NOT loaded&#10;INFORMATIONAL → quarantined AND loaded" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="2674" width="260" height="98" as="geometry"/></mxCell><mxCell id="eT7s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T7" target="T7_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T8" value="T8  ·  ANY CRITICAL FAILURE?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFC000;strokeColor=#BF8F00;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="2842" width="300" height="92" as="geometry"/></mxCell><mxCell id="T8_c" value="READS&#10;each rule’s outcome and severity" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2856" width="250" height="64" as="geometry"/></mxCell><mxCell id="eT8c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T8_c" target="T8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T8_f" value="JOB FAILED&#10;Any CRITICAL failure fails the job.&#10;INFORMATIONAL failures alone complete&#10;the job WITH A WARNING." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#C00000;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="2852" width="260" height="72" as="geometry"/></mxCell><mxCell id="eT8f" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=10;fontColor=#C00000;" edge="1" parent="1" source="T8" target="T8_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T9" value="T9  ·  DOES RECONCILIATION BALANCE?&#10;source against target" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFC000;strokeColor=#BF8F00;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="2990" width="300" height="92" as="geometry"/></mxCell><mxCell id="T9_c" value="READS&#10;which metrics to reconcile&#10;counts, and amounts where the table&#10;has a measure" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="3000" width="250" height="72" as="geometry"/></mxCell><mxCell id="eT9c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T9_c" target="T9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T9_f" value="JOB FAILED&#10;The loaded data is LEFT VISIBLE for&#10;investigation rather than rolled back —&#10;which is also what an auditor wants." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4E4;strokeColor=#C00000;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="3000" width="260" height="72" as="geometry"/></mxCell><mxCell id="eT9f" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=10;fontColor=#C00000;" edge="1" parent="1" source="T9" target="T9_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T10" value="T10  ·  POST-LOAD STEPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1DD;strokeColor=#375623;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="3142" width="340" height="64" as="geometry"/></mxCell><mxCell id="T10_c" value="READS&#10;what this table’s config requires after&#10;the write — delete sweep, housekeeping,&#10;statistics" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="3138" width="250" height="72" as="geometry"/></mxCell><mxCell id="eT10c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" source="T10_c" target="T10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="T11" value="T11  ·  CLOSE THE JOB RUN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1DD;strokeColor=#375623;fontFamily=Arial;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="3264" width="340" height="64" as="geometry"/></mxCell><mxCell id="T11_s" value="WRITES&#10;outcome and counts&#10;&#10;Stored state — the watermark — advances&#10;ONLY on success" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontFamily=Arial;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="3254" width="260" height="85" as="geometry"/></mxCell><mxCell id="eT11s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A6A6A6;strokeWidth=1;dashed=1;endArrow=open;endSize=6;" edge="1" parent="1" so